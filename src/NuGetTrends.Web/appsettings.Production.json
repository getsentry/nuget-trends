{
  "Sentry": {
    "Dsn": "Set via env var Sentry__Dsn",
    "DiagnosticLevel": "Info"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Sentry": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Sentry"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
